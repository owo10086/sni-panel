# Context is extracted from the verified panel tarball, never the source tree.
FROM node:22.23.3-alpine AS production-dependencies
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.28.1 --activate
RUN apk add --no-cache python3 make g++ git
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
RUN pnpm install --frozen-lockfile --prod

FROM node:22.23.3-alpine AS runner
WORKDIR /app
ARG FORWARDX_VERSION
ARG FORWARDX_COMMIT
ENV NODE_ENV=production PORT=3000 FORWARDX_PORT_MANAGEMENT=docker \
    DATABASE_CONFIG_PATH=/data/database.json SQLITE_PATH=/data/forwardx.db \
    MYSQL_CONFIG_PATH=/data/mysql.json FORWARDX_IMAGE_VERSION=$FORWARDX_VERSION
LABEL org.opencontainers.image.version=$FORWARDX_VERSION org.opencontainers.image.revision=$FORWARDX_COMMIT
RUN apk add --no-cache tini git curl openssl docker-cli docker-cli-compose && mkdir -p /data
COPY --from=production-dependencies /app/node_modules ./node_modules
COPY dist ./dist
COPY client/dist ./client/dist
COPY drizzle ./drizzle
COPY package.json THIRD_PARTY_NOTICES.md ./
VOLUME ["/data"]
EXPOSE 3000
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/index.js"]
