+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { spawnSync } from "node:child_process";
+import test from "node:test";
+
+const workflow = fs.readFileSync(new URL("../.github/workflows/android-apk.yml", import.meta.url), "utf8");
+const signingKeys = ["ANDROID_KEYSTORE_BASE64", "ANDROID_KEYSTORE_PASSWORD", "ANDROID_KEY_ALIAS", "ANDROID_KEY_PASSWORD"];
+
+function workflowScript(name) {
+  const step = workflow.split("      - name: ").find(value => value.startsWith(`${name}\n`));
+  assert.ok(step, `Workflow step ${name} exists`);
+  const script = step.split("        run: |\n")[1];
+  assert.ok(script, `Workflow step ${name} exposes its shell entry point`);
+  return script.split("\n").map(line => line.replace(/^ {10}/, "")).join("\n");
+}
+
+function runSigning(values, check) {
+  const directory = fs.mkdtempSync(path.join(os.tmpdir(), "forwardx-android-signing-"));
+  const output = path.join(directory, "output");
+  const summary = path.join(directory, "summary");
+  fs.writeFileSync(output, "");
+  fs.writeFileSync(summary, "");
+  const environment = { ...process.env, GITHUB_OUTPUT: output, GITHUB_STEP_SUMMARY: summary };
+  for (const key of signingKeys) environment[key] = values[key] || "";
+  try {
+    const result = spawnSync("bash", ["-c", workflowScript("Prepare release signing")], { cwd: directory, env: environment, encoding: "utf8", timeout: 10000 });
+    check({ result, directory, output: fs.readFileSync(output, "utf8"), summary: fs.readFileSync(summary, "utf8") });
+  } finally {
+    fs.rmSync(directory, { recursive: true, force: true });
+  }
+}
+
+test("missing original Android signing never declares a signed release or creates a replacement key", () => {
+  runSigning({}, ({ result, directory, output, summary }) => {
+    assert.equal(result.status, 0, result.stderr);
+    assert.match(output, /^signed=false$/m);
+    assert.doesNotMatch(output, /^signed=true$/m);
+    assert.equal(fs.existsSync(path.join(directory, "android/app/keystore")), false);
+    assert.match(summary, /ANDROID_KEYSTORE_BASE64/);
+    assert.match(summary, /not (?:generated|produced)/i);
+  });
+});
+
+test("invalid supplied key encoding fails before announcing signing readiness", () => {
