+
+test("a late host response cannot replace the selected host or block an independent monitor request", async () => {
+  const client = new QueryClient();
+  const flush = () => new Promise<void>((resolve) => setImmediate(resolve));
+  let finishOld: ((response: Response) => void) | undefined;
+  const fetcher: typeof fetch = async (input) => {
+    if (String(input).endsWith("/1")) return new Promise<Response>((resolve) => { finishOld = resolve; });
+    return new Response(JSON.stringify({ hostId: 2, cpuUsage: 57 }));
+  };
+  const options = (hostId: number) => ({
+    ...PUBLIC_MONITOR_REFRESH_OPTIONS,
+    queryKey: ["public-monitor-host", hostId],
+    queryFn: async () => (await fetchPublicMonitor(fetcher, "https://panel.test/" + hostId)).json() as Promise<{ hostId: number; cpuUsage: number }>,
+  });
+  const observer = new QueryObserver(client, options(1));
+  const unsubscribe = observer.subscribe(() => {});
+  try {
+    await flush();
+    assert.ok(finishOld, "the first host request is still waiting");
+    observer.setOptions(options(2));
+    await observer.refetch();
+    assert.deepEqual(observer.getCurrentResult().data, { hostId: 2, cpuUsage: 57 });
+    finishOld(new Response(JSON.stringify({ hostId: 1, cpuUsage: 23 })));
+    await flush();
+    assert.deepEqual(observer.getCurrentResult().data, { hostId: 2, cpuUsage: 57 });
+    const timeout = fetchPublicMonitor(async (_input, init) => new Promise<Response>((_resolve, reject) => {
+      init?.signal?.addEventListener("abort", () => reject(init.signal?.reason), { once: true });
+    }), "https://panel.test/summary", undefined, 20);
+    const independent = await fetchPublicMonitor(fetcher, "https://panel.test/2");
+    assert.deepEqual(await independent.json(), { hostId: 2, cpuUsage: 57 });
+    await assert.rejects(timeout, { name: "TimeoutError" });
+  } finally {
+    unsubscribe();
+    client.clear();
+  }
+});
